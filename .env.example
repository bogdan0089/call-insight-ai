DATABASE_URL=postgresql+asyncpg://lab:lab@localhost:5434/radar
REDIS_URL=redis://localhost:6381/0
RABBITMQ_URL=amqp://lab:lab@localhost:5673//

DB_ECHO=false
LOG_LEVEL=INFO
STORAGE_DIR=storage

GROQ_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

TELEPHONY_WEBHOOK_SECRET=dev-secret
JWT_SECRET=dev-jwt-secret

CORS_ORIGINS=["http://localhost:3100"]

FRONTEND_URL=http://localhost:3100
EMAIL_VERIFICATION_TTL_HOURS=24

DEMO_ENABLED=false
DEMO_EMAIL=demo@call-insight.local

# Mail: with an empty SMTP_HOST, messages are written to MAIL_DIR.
# Port 465 uses SMTPS, 587 uses STARTTLS.
# Local mailpit: SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_USE_TLS=false,
# then read messages at http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@call-insight.local
SMTP_FROM_NAME=call insight
MAIL_DIR=storage/mail
# false sends inside the request, useful without a running worker
MAIL_ASYNC=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
TRUST_FORWARDED_FOR=false
# RATE_LIMITS={"login_email": "5/300", "ip": "300/60"}
